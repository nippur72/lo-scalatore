10 REM P01 - PROVA DELLE CONVENZIONI SINTATTICHE LM80C
20 REM verifica: spazi fra keyword e operandi, nomi variabile di 2 caratteri,
30 REM REM a fine riga, righe entro 88 colonne, ELSE e niente '.
40 SCREEN 1:COLOR 1,15,15
50 CLS
60 LOCATE 0,0:PRINT "P01 CONVENZIONI SINTATTICHE LM80C"
70 A=1:B=2
80 LOCATE 0,2:PRINT "SOMMA: ";A+B
90 SS=10:SC=20
100 LOCATE 0,3:PRINT "SS E SC SONO DISTINTE:";SS;SC
110 LOCATE 0,5:PRINT "RIGA DI 80 COLONNE DI PROVA PER CONTROLLARE IL LIMITE DEGLI 88"
120 LOCATE 0,7:IF A=1 THEN PRINT "IF-THEN OK" ELSE PRINT "IF-THEN KO"
130 FOR N=1 TO 3:LOCATE 0,8+N:PRINT "CICLO FOR NUMERO";N:NEXT
140 LOCATE 0,12:PRINT "FINE P01 - SE LEGGI QUESTO, LA SINTASSI VA BENE"
