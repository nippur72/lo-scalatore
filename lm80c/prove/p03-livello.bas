10 REM P03 - GRIGLIA VRAM: DISEGNA UN LIVELLO E POI RILEGGE LA MAPPA
20 SCREEN 1:COLOR 1,15,15
30 DIM B(11):DIM BA(11):DIM CD(6)
40 Z=16:J=8:E1=2:E2=0
50 DATA 0,1,8,16,24,40,41
60 DATA 0,0,0,0,0,0,0,0
70 DATA 0,0,0,0,0,0,0,0
80 DATA 255,255,153,102,102,153,255,255
90 DATA 195,255,255,195,195,255,255,195
100 DATA 60,66,165,153,153,165,66,60
110 DATA 60,60,25,255,188,60,36,231
120 DATA 0,24,36,126,126,126,126,0
130 DATA 0,1,21,22,23,24,42,43,44,45,46,47
140 FOR N=0 TO 6:READ CD(N):NEXT
150 FOR N=0 TO 6:FOR M=0 TO 7:READ DT:VPOKE CD(N)*8+M,DT:NEXT:NEXT
160 VPOKE 8193,223:VPOKE 8194,143:VPOKE 8195,191:VPOKE 8197,31
170 FOR N=0 TO 11:READ B(N):OF=B(N)+32:BA(N)=6149+32*(OF#22)+(OF%22):NEXT
180 GOSUB 1000
190 LOCATE 0,0:PRINT "P03 LIVELLO: PREMI SPAZIO PER I CONTEGGI "
200 K=INKEY(0):IF K=0 THEN 200
210 CLS:GOSUB 2000
220 LOCATE 0,13:PRINT "PREMI RUN/STOP PER TORNARE AL BASIC"
230 GOTO 200
1000 REM disegna il livello (e' la routine 70-97 del gioco)
1010 CLS
1020 VPOKE 6251,1:VPOKE 6260,1
1030 VPOKE 6283,16:FOR N=6284 TO 6291:VPOKE N,8:NEXT:VPOKE 6292,16
1040 VPOKE 6315,16:VPOKE 6324,16:VPOKE 6347,16:VPOKE 6356,16
1050 FOR N=0 TO 11:VPOKE BA(N),24:NEXT
1060 FOR N=6373 TO 6853 STEP 160:IF N=6853 THEN 1130
1070 FOR O=1 TO 3
1080 R=N+1+INT(RND(1)*20):IF VPEEK(R)<>J THEN 1080
1090 FOR M=R TO R+128 STEP 32:VPOKE M,Z:NEXT
1100 IF O>1 AND RND(1)<E2 THEN VPOKE R+(INT(RND(1)*2)+2)*32,1
1110 IF RND(1)<.5 AND VPEEK(R-32)=0 THEN VPOKE R-32,1
1120 NEXT
1130 FOR O=1 TO E1
1140 R=N+3+INT(RND(1)*16):IF VPEEK(R)<>J THEN 1180
1150 IF VPEEK(R-32)<>0 OR VPEEK(R+1)=0 OR VPEEK(R-1)=0 THEN 1180
1160 VPOKE R,0:VPOKE R-32,1
1180 NEXT
1190 FOR O=1 TO 4
1200 R=N-32+INT(RND(1)*20):IF VPEEK(R)<>0 OR VPEEK(R+32)=0 THEN 1200
1210 VPOKE R,41:NEXT:NEXT
1220 VPOKE 6189,1:VPOKE 6194,1:VPOKE 6220,1:VPOKE 6227,1
1230 FOR N=6341 TO 6821 STEP 160:VPOKE N,1:NEXT
1240 FOR N=6362 TO 6842 STEP 160:VPOKE N,1:NEXT
1250 RETURN
2000 REM conteggio dei tile presenti (righe 1-22, colonne 0-21)
2010 A0=0:A1=0:A8=0:AZ=0:AB=0:AM=0:AG=0
2020 FOR RW=1 TO 22:FOR CL=0 TO 21:AD=6149+32*RW+CL:DT=VPEEK(AD)
2030 IF DT=0 THEN A0=A0+1
2040 IF DT=1 THEN A1=A1+1
2050 IF DT=8 THEN A8=A8+1
2060 IF DT=16 THEN AZ=AZ+1
2070 IF DT=24 THEN AB=AB+1
2080 IF DT=40 THEN AM=AM+1
2090 IF DT=41 THEN AG=AG+1
2100 NEXT:NEXT
2110 LOCATE 0,0:PRINT "CONTI SU 22 COLONNE X 22 RIGHE:"
2120 LOCATE 0,2:PRINT "SPAZI (0)   :";A0
2130 LOCATE 0,3:PRINT "DEVIATORI(1):";A1
2140 LOCATE 0,4:PRINT "TRAVI (8)   :";A8
2150 LOCATE 0,5:PRINT "SCALE (16)  :";AZ
2160 LOCATE 0,6:PRINT "BARILI (24) :";AB
2170 LOCATE 0,7:PRINT "OMINO (40)  :";AM
2180 LOCATE 0,8:PRINT "BORSE (41)  :";AG
2190 LOCATE 0,10:PRINT "ATTESI: BARILI 12, 3 SCALE PER TRAVE"
2200 LOCATE 0,11:PRINT "TRAVI: 4 RIGHE DA 21 CELLE MENO SCALE E BUCHI"
2210 RETURN
