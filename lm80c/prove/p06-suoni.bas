10 REM P06 - SUONI: VOLUME, BEEP, SALTO, MORTE, BONUS, RUMORE
12 REM NB: SOUND ch,tone,dur per i toni (1-3) ha TRE parametri obbligatori;
14 REM per il rumore (4-6) e' SOUND ch,tone e niente altro; SOUND 0 azzera
16 REM anche i volumi, quindi dopo ogni SOUND 0 va rimesso VOLUME 0,15
20 SCREEN 1:COLOR 1,15,15
30 CLS
40 VOLUME 0,15
50 LOCATE 0,0:PRINT "P06 SUONI (PSG) - PREMI UN NUMERO"
60 LOCATE 0,2:PRINT "1 BEEP DEL PASSO   (SOUND 1,3730,1) = 315 HZ, VIC 36876=200"
70 LOCATE 0,3:PRINT "2 SUONO DEL SALTO  (SOUND 1,3996,5) = 1152 HZ, VIC 36876=240"
80 LOCATE 0,4:PRINT "3 MORTE (DISCESA 866 -> 43 HZ, COME IL VIC-20)"
90 LOCATE 0,5:PRINT "4 BONUS LIVELLO (RUMORE + RAMPA)"
100 LOCATE 0,6:PRINT "5 SCALA DI PROVA SUL PSG (TONE 3550 -> 4050)"
110 LOCATE 0,8:PRINT "SE NON SENTI NULLA, CONTROLLA IL VOLUME"
120 K=INKEY(0):IF K=0 THEN 120
130 IF K<49 OR K>53 THEN 120
140 LOCATE 0,10:PRINT "SUONO N.";K-48;"      "
150 IF K=49 THEN GOSUB 200
160 IF K=50 THEN GOSUB 210
170 IF K=51 THEN GOSUB 220
180 IF K=52 THEN GOSUB 230
190 IF K=53 THEN GOSUB 240
195 GOTO 120
200 SOUND 1,3730,1:RETURN
210 SOUND 1,3996,5:RETURN
220 REM valore registro VIC voce 1: 250 -> 155, freq = 4329/(255-v)
222 SO=255:FOR N=1 TO 20:SO=SO-5:SOUND 1,4096-INT(26.6112*(255-SO)),0
225 FOR M=1 TO 17:NEXT:NEXT
228 SOUND 0:VOLUME 0,15:RETURN
229 REM rumore: VIC 36877=250 -> 34640/5 = 6928 Hz -> tone 17 (6776 Hz)
230 SOUND 4,17
232 FOR M=240 TO 250:SOUND 1,4096-INT(6.6513*(255-M)),1:NEXT
235 SOUND 0:VOLUME 0,15:RETURN
240 FOR N=3550 TO 4050 STEP 50:SOUND 1,N,3
245 FOR M=1 TO 30:NEXT:NEXT
248 SOUND 0:VOLUME 0,15:RETURN
