10 REM P05 - RIGA DI STATO: PUNTEGGIO, VITE, LIVELLO
20 SCREEN 1:COLOR 1,15,15
30 CLS
40 SS=0:CH=2:SC=1:Q=10000:E3=1
50 GOSUB 200:GOSUB 210
60 LOCATE 0,3:PRINT "AUMENTO IL PUNTEGGIO DI 150 PUNTI PER VOLTA"
70 LOCATE 0,4:PRINT "PREMENDO SPAZIO PASSO AL LIVELLO SUCCESSIVO"
80 LOCATE 0,6:PRINT "RIGA 0: PUNTEGGIO FINO A COL 8, VITE COL 14"
82 LOCATE 0,7:PRINT "LIVELLO COL 17 E SUBITO DOPO IL SIMBOLO #"
90 FOR N=1 TO 30:SS=SS+150:GOSUB 200:GOSUB 220
100 FOR M=1 TO 60:NEXT:NEXT
110 K=INKEY(0):IF K=0 THEN 110
120 IF K<>32 THEN 110
130 SC=SC+1:GOSUB 210
140 GOTO 110
200 LOCATE 8-LEN(STR$(SS)),0:PRINT SS;
210 LOCATE 14,0:PRINT CH;:LOCATE 17,0:PRINT "#";SC;
230 RETURN
