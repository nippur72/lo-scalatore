10 REM P07 - SPRITE SU SCREEN 1: PROVA MINIMA POI ALLINEAMENTO COI TILE
20 REM 1) uno sprite al centro  2) due sprite sopra due tile  3) H nasconde
30 SCREEN 1:COLOR 1,15,15
40 CLS
50 REM pattern del barile (tile 24) e dell'omino (tile 40), come nel gioco
60 DATA 60,66,165,153,153,165,66,60
70 DATA 60,60,25,255,188,60,36,231
80 FOR M=0 TO 7:READ DT:VPOKE 192+M,DT:NEXT:FOR M=0 TO 7:READ DT:VPOKE 320+M,DT:NEXT
90 REM pattern degli sprite: 0 = omino, 1 = barile (stessi valori dei tile)
100 DATA 60,60,25,255,188,60,36,231
110 DATA 60,66,165,153,153,165,66,60
120 FOR M=0 TO 15:READ DT:VPOKE 14336+M,DT:NEXT
130 VPOKE 8195,191:VPOKE 8197,31
140 REM SAT: sprite 0 omino nero pat 0, sprite 1 barile giallo pat 1
150 VPOKE 6912,208:VPOKE 6914,0:VPOKE 6915,1:VPOKE 6918,1:VPOKE 6919,11
160 VPOKE 6916,208:VPOKE 6920,208
170 REM FASE 1: un solo sprite al centro dello schermo (byte Y=99, X=120)
180 VPOKE 6912,99:VPOKE 6913,120
190 LOCATE 0,0:PRINT "P07 SPRITE SU SCREEN 1 - FASE 1"
200 LOCATE 0,1:PRINT "ATTESO: UNA SAGOMA NERA 8X8 A META' SCHERMO"
210 LOCATE 0,2:PRINT "(sprite 0 = omino, colore 1 = nero, pattern 0)"
220 LOCATE 0,4:PRINT "PATTERN SPRITE 0 (14336..14343):";
230 FOR M=0 TO 7:PRINT VPEEK(14336+M);" ";:NEXT:PRINT "  "
240 LOCATE 0,5:PRINT "TILE OMINO (320..327):";
250 FOR M=0 TO 7:PRINT VPEEK(320+M);" ";:NEXT:PRINT "  "
260 LOCATE 0,6:PRINT "SAT 6912..6919:";:FOR M=6912 TO 6919:PRINT VPEEK(M);" ";:NEXT
270 LOCATE 0,7:PRINT "I DUE ELENCHI DEVONO COINCIDERE, Y=99 X=120 PAT=0 COL=1"
280 LOCATE 0,9:PRINT "PREMI UN TASTO PER LA FASE 2 (SPRITE SOPRA I TILE)"
290 K=INKEY(0):IF K=0 THEN 290
300 CLS
310 REM FASE 2: sprite 0 (omino) sopra il tile 40 riga 10 col 5 (Y=79, X=40)
320 VPOKE 6469,40:VPOKE 6912,79:VPOKE 6913,40
330 REM sprite 1 sulla trave di riga 12 (Y=95) e tile barile a colonna 8
340 FOR C=5 TO 25:VPOKE 6528+C,8:NEXT:VPOKE 6536,24
350 VPOKE 6916,95:VPOKE 6917,40
360 LOCATE 0,0:PRINT "P07 FASE 2 - RIGA 10: SPRITE 0 SOPRA IL TILE 40"
370 LOCATE 0,1:PRINT "RIGA 12: IL BARILE SCORRE SULLA TRAVE"
380 LOCATE 0,2:PRINT "A COLONNA 8 C'E' IL TILE DEL BARILE: DEVE COINCIDERE"
390 LOCATE 0,20:PRINT "H=NASCONDI/MOSTRA BARILE   SPAZIO=OMINO A DESTRA"
400 C=5
410 X=8*C:VPOKE 6917,X
420 PAUSE 20
430 LOCATE 0,21:PRINT "X =";X;" COLONNA =";C;" TILE SOTTO =";VPEEK(6528+C);"  "
440 LOCATE 0,22:PRINT "SAT 6912..6919:";
450 FOR M=6912 TO 6919:PRINT VPEEK(M);" ";:NEXT:PRINT "  "
460 K=INKEY(0)
470 IF K=72 THEN GOSUB 600
480 IF K=32 THEN VPOKE 6913,VPEEK(6913)+8
490 C=C+1:IF C>25 THEN C=5
500 GOTO 410
600 REM H: nasconde/mostra lo sprite 1 (208 = 0xD0 termina la lista)
610 IF VPEEK(6916)=208 THEN VPOKE 6916,95:GOTO 630
620 VPOKE 6916,208
630 RETURN
