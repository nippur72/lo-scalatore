10 REM P04 - TASTIERA: CODICI INKEY E MAPPA DEI COMANDI DI GIOCO
20 SCREEN 1:COLOR 1,15,15
30 CLS
40 REM auto-repeat come nel gioco: 0,08 s di attesa, 0,02 s fra due pressioni
50 KEY 9,8,2
60 LOCATE 0,0:PRINT "P04 TASTIERA - PREMI UN TASTO"
70 LOCATE 0,2:PRINT "CODICE INKEY :"
80 LOCATE 0,3:PRINT "AZIONE GIOCO :"
90 LOCATE 0,5:PRINT "30=SU 31=GIU 28=SINISTRA 29=DESTRA 32=SALTO"
100 LOCATE 0,6:PRINT "RIPETIZIONE AUTO-REPEAT: Tieni premuto un tasto"
110 LOCATE 0,7:PRINT "PER USCIRE: RUN/STOP"
120 K=INKEY(0):IF K=0 THEN 120
130 LOCATE 16,2:PRINT K;"    "
140 A$="(NESSUN COMANDO)"
150 IF K=32 THEN A$="SALTO       "
160 IF K=31 THEN A$="GIU         "
170 IF K=28 THEN A$="SINISTRA    "
180 IF K=30 THEN A$="SU          "
190 IF K=29 THEN A$="DESTRA      "
200 LOCATE 16,3:PRINT A$
210 GOTO 120
