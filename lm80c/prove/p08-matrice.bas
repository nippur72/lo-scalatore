0 REM p08 - prova della routine ML di input (lm80c/ml/lm80c_keys.asm)
1 REM mostra la matrice grezza, i flag, il K del gioco e il modo test
2 SCREEN 1:COLOR 1,15,15
3 AD=30720:RESTORE 1000:READ LN:FOR N=0 TO LN-1:READ DT:POKE AD+N,DT:NEXT:RESTORE 1000
4 SB=AD+268:CLS:LOCATE 0,0:PRINT "routine ML caricata: ";LN;" byte  "
5 PRINT "stato a ";SB;" ingresso a ";AD
10 REM ciclo principale: una lettura per fotogramma
11 SYS AD:K=PEEK(SB):F=PEEK(SB+1):PR=PEEK(SB+10)
12 LOCATE 0,2:PRINT "MATRICE (0 = premuto):   "
13 FOR R=0 TO 7
14 V=PEEK(SB+2+R):PRINT "R";R;" ";
15 FOR B=0 TO 7:IF V AND 2^B THEN PRINT "."; ELSE PRINT "0";
16 NEXT:PRINT
17 NEXT
18 PRINT "FLAG ";F;" K ";K;" SPZ ";PR;"      "
19 REM modo test: SYS AD,codice -> PEEK(SB) = 1 se premuto
20 SYS AD,28:T1=PEEK(SB):SYS AD,29:T2=PEEK(SB)
21 SYS AD,30:T3=PEEK(SB):SYS AD,31:T4=PEEK(SB):SYS AD,32:T5=PEEK(SB)
22 PRINT "TEST 28:";T1;" 29:";T2;" 30:";T3;" 31:";T4;" 32:";T5;"   "
23 PRINT "riga6: 0=SINISTRA 7=DESTRA"
24 PRINT "riga5: 0=GIU 2=L 7=SU    "
25 PRINT "riga4: 1=I 2=J 5=K       "
26 PRINT "riga0: 4=SPAZIO riga1: 4=Z"
27 PRINT "alias: J L I K Z          "
28 PAUSE 3:GOTO 11
